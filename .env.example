# ============================================================
# Paper Labeler 云端配置模板
# 复制为 .env 并填入真实值（.env 已在 .gitignore，不要提交）
# ============================================================

# ----- Supabase -----
# Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# 网页端（web/）只用 anon key，经 RLS 受控访问
SUPABASE_ANON_KEY=

# 标注端同步专用：service role 绕过 RLS，仅在你自己机器上使用
SUPABASE_SERVICE_ROLE_KEY=

# ----- Cloudflare R2 -----
# R2 Dashboard → Bucket → Settings → S3 API
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=paper-labeler

# 公开读地址（MVP 防盗链为 P3，先用 r2.dev 公开域名或自定义域）
# R2 Dashboard → Bucket → Settings → Public Development URL
R2_PUBLIC_BASE=https://pub-xxxxxxxxxxxx.r2.dev

# ----- 同步开关 -----
# 标注端出现「同步到云端」入口的开关（1=开启）
PAPER_CLOUD_ENABLED=0
